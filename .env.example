# Copy to .env.local (and add the same keys in your host's environment settings).

# Neon → your project → Connection string (pooled).
DATABASE_URL=

# The one password that unlocks the app. Pick something long.
APP_PASSWORD=

# Signs the login cookie. Generate with:  openssl rand -hex 32
SESSION_SECRET=

# Dev-only: run the UI on in-memory sample data, no database needed. Ignored in production builds.
# NEXT_PUBLIC_DEMO=1
